alias cl='clear'
alias homecl='cd ~ && clear'
alias llh='ls -lahF'
alias lll='clear && ls -lahF'
alias uuu='sudo apt update && sudo apt list --upgradable && sudo apt upgrade -y && sudo apt autoremove -y'
alias pyact='source /opt/venv/bin/activate'
alias pyansible='source /opt/ansible/bin/activate'
alias pykubespray='source /opt/pykubespray/bin/activate'
alias dockrm='sudo docker rm --force `sudo docker ps -aq`'
alias dockrmi='sudo docker rmi --force `sudo docker images -q | grep -v 9f413b60dbe4`'
alias aptinstall='sudo apt update && sudo apt install -y'
alias k='kubectl'
alias k3='kubectl config use-context k3s'
alias k8='kubectl config use-context k8s'
alias swapaws='$HOME/.aws/swap.sh'
alias pwssh='xclip -sel c < ~/.work-secrets/ssh'
alias wvpnup='nmcli con up Acti_HE'
alias wvpndown='nmcli con down Acti_HE'
alias exipa='curl ident.me; echo'
alias dk='sudo docker'
alias dkc='sudo docker-compose'
alias dkbash='sudo docker run -ti --rm --entrypoint=bash'
alias dksh='sudo docker run -ti --rm --entrypoint=sh'
alias ter='terraform'
alias kdbg='kubectl run debug --rm -ti --image=nicolaka/netshoot -- bash'
alias chost='cat /etc/hosts | grep'
alias ssubl='sudo subl'
